# ============================================
# DRFX Trading Dashboard v2.1 — EA Push Mode
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)
# ============================================

MT5_ACCOUNTS=[]

# Server
HOST=0.0.0.0
PORT=8000

# Update intervals (seconds)
WS_UPDATE_INTERVAL=5
NEWS_UPDATE_INTERVAL=300

# Database settings
SNAPSHOT_INTERVAL=300
DATA_RETENTION_DAYS=90

# EA Push API Key (ต้องตรงกับ Input ใน EA) — จำเป็น, ว่าง = ปฏิเสธ push ทั้งหมด
EA_API_KEY=

# News API (optional)
FMP_API_KEY=

# Apps Script License Server
APPS_SCRIPT_URL=
LICENSE_ADMIN_KEY=
APPS_SCRIPT_TIMEOUT=30

# Catalog
# CATALOG_CORS_ORIGINS=https://drfxtrading.net,http://localhost:3001
# CATALOG_DATA_DIR=
CATALOG_KEEP_BACKUPS=10

# ============================================
# Telegram Notifications
# ============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# เวลาส่งสรุปรายวัน (UTC, 0-23)
TELEGRAM_DAILY_HOUR=21
TELEGRAM_DAILY_MIN=30

# ============================================
# Dashboard admin login
# สร้าง hash: python -c "import bcrypt; print(bcrypt.hashpw(b'YourPassword', bcrypt.gensalt()).decode())"
# ============================================
ADMIN_USER=admin
ADMIN_PASS_HASH=
FLASK_SECRET=
SESSION_LIFETIME_HOURS=8
COOKIE_SECURE=false
